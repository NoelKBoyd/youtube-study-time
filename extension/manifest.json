{
  "manifest_version": 3,
  "name": "Study Time",
  "version": "1.1.0",
  "description": "A study timer for YouTube. Pick a topic and a time; until it ends, YouTube only suggests videos about that topic.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Study Time",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["shared/shared.js", "shared/ui.js", "content/content.js"],
      "css": ["shared/theme.css", "content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
